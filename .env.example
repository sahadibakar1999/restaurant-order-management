PORT=3000
NODE_ENV=development

# WhatsApp Cloud API credentials (Meta Developer Console)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
# Any long random string; paste the same value into Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta App > Settings > Basic > App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=

# Admin panel login (username defaults to "admin")
ADMIN_USER=admin
ADMIN_PASSWORD=

# Restaurant Customization
RESTAURANT_NAME="Royal Spice Bistro"

# Optional: Claude understands free-text orders ("2 naan and a lassi")
ANTHROPIC_API_KEY=
# Optional: owner's WhatsApp number for the nightly sales summary
OWNER_WHATSAPP=
# Optional: public URL used in table QR codes, e.g. https://your-app.onrender.com
PUBLIC_BASE_URL=
